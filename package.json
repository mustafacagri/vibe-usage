{
  "name": "vibe-usage",
  "version": "0.1.1",
  "description": "Windows ve macOS için yerel AI abonelik kullanım izleyicisi",
  "author": "Mustafa Çağrı Güven",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "build/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "npm run build && electron .",
    "test": "node --test 'test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 'test/**/*.test.ts'",
    "cli": "node src/cli.ts",
    "watch": "node src/cli.ts watch",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "ui-check": "npm run build && electron scripts/ui-check/main.ts",
    "icons": "node scripts/icons.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "build": {
    "appId": "dev.vibe.usage",
    "productName": "Vibe Usage",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*.js",
      "build/**/*.cjs",
      "build/ui/index.html",
      "build/ui/style.css",
      "build/launchers/*",
      "assets/*",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "build/launchers/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
