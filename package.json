{
  "name": "vibe-usage",
  "version": "0.1.1",
  "description": "Windows ve macOS için yerel AI abonelik kullanım izleyicisi",
  "author": "Mustafa Cagri",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "cli": "node src/cli.cjs",
    "watch": "node src/cli.cjs watch",
    "build:win": "electron-builder --win dir zip",
    "build:mac": "electron-builder --mac dmg zip",
    "ui-check": "electron scripts/ui-check/main.cjs",
    "icons": "node scripts/icons.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "dev.vibe.usage",
    "productName": "Vibe Usage",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/launchers/*"
    ],
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
